{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/update-password",
      "destination": "/api/auth/login?action=update-password"
    },
    {
      "source": "/api/auth/revoke-all-sessions",
      "destination": "/api/auth/login?action=revoke-all-sessions"
    },
    {
      "source": "/api/trips/invite/lookup",
      "destination": "/api/trips/invite-lookup?action=invite-lookup"
    },
    {
      "source": "/api/trips/invite/join",
      "destination": "/api/trips/invite-join?action=invite-join"
    },
    {
      "source": "/api/trips/join",
      "destination": "/api/trips/invite-join?action=invite-join"
    },
    {
      "source": "/api/trips/invite/:code",
      "destination": "/api/trips/invite-lookup?action=invite-lookup&code=:code"
    },
    {
      "source": "/api/telegram/settings",
      "destination": "/api/telegram/admin?action=settings"
    },
    {
      "source": "/api/telegram/test",
      "destination": "/api/telegram/admin?action=test"
    },
    {
      "source": "/api/telegram/detect-chat",
      "destination": "/api/telegram/admin?action=detect-chat"
    },
    {
      "source": "/api/health/history",
      "destination": "/api/health?action=history"
    },
    {
      "source": "/api/health/run-check",
      "destination": "/api/health?action=run-check"
    },
    {
      "source": "/api/cron/daily-check",
      "destination": "/api/health?action=cron"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-check",
      "schedule": "30 20 * * *"
    }
  ]
}
