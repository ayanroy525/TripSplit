{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://api.frankfurter.app https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/login?action=logout"
    },
    {
      "source": "/api/auth/update-password",
      "destination": "/api/auth/login?action=update-password"
    },
    {
      "source": "/api/auth/revoke-all-sessions",
      "destination": "/api/auth/login?action=revoke-all-sessions"
    },
    {
      "source": "/api/trips/invite/lookup",
      "destination": "/api/trips/[tripId]?tripId=invite-lookup&action=invite-lookup"
    },
    {
      "source": "/api/trips/invite/join",
      "destination": "/api/trips/[tripId]?tripId=invite-join&action=invite-join"
    },
    {
      "source": "/api/trips/join",
      "destination": "/api/trips/[tripId]?tripId=invite-join&action=invite-join"
    },
    {
      "source": "/api/trips/invite/:code",
      "destination": "/api/trips/[tripId]?tripId=invite-lookup&action=invite-lookup&code=:code"
    },
    {
      "source": "/api/trips/link-members",
      "destination": "/api/trips/[tripId]?tripId=link-members&action=link-members"
    },
    {
      "source": "/api/trips/:tripId/:resource/:itemId",
      "destination": "/api/trips/[tripId]?tripId=:tripId&resource=:resource&itemId=:itemId"
    },
    {
      "source": "/api/trips/:tripId/:resource",
      "destination": "/api/trips/[tripId]?tripId=:tripId&resource=:resource"
    },
    {
      "source": "/api/trips",
      "destination": "/api/trips/[tripId]?tripId=trips-root&action=trips-root"
    },
    {
      "source": "/api/telegram/settings",
      "destination": "/api/telegram/admin?action=settings"
    },
    {
      "source": "/api/telegram/test",
      "destination": "/api/telegram/admin?action=test"
    },
    {
      "source": "/api/telegram/detect-chat",
      "destination": "/api/telegram/admin?action=detect-chat"
    },
    {
      "source": "/api/health/history",
      "destination": "/api/health?action=history"
    },
    {
      "source": "/api/health/run-check",
      "destination": "/api/health?action=run-check"
    },
    {
      "source": "/api/cron/daily-check",
      "destination": "/api/health?action=cron"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-check",
      "schedule": "30 20 * * *"
    }
  ]
}
