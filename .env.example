# Public frontend configuration. These VITE_* values are bundled into the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server/AI configuration. Never expose these through VITE_* variables
# or import them from browser code.
GEMINI_API_KEY=
APP_URL=http://localhost:5173

# Server-only Supabase/Postgres values. Keep these out of deployed frontend environments.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
