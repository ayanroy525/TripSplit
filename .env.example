# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client & Server)
# Never use the VITE_ prefix for secrets (such as service_role keys or auth tokens).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL Database Configuration (Server-only secret)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Sentry Error Monitoring
# Public client DSN (safe for browser; used only in production builds)
VITE_SENTRY_DSN=
# Public release identifier (e.g. tripsplit@1.0.0 or git SHA)
VITE_APP_VERSION=
# Server-side Sentry DSN for Vercel /api functions (server-only)
SENTRY_DSN=
# SECRET (BUILD-ONLY): Sentry auth token for uploading hidden source maps during `vite build`.
# NEVER prefix with VITE_ and NEVER expose to client or runtime code.
SENTRY_AUTH_TOKEN=
# Sentry organization slug and project slug (build-only, used with SENTRY_AUTH_TOKEN)
SENTRY_ORG=
SENTRY_PROJECT=
